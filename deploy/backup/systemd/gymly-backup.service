[Unit]
Description=Gymly backup: data and configuration to the off-site restic repository
Documentation=file:///usr/local/share/doc/gymly-backup/DISASTER_RECOVERY.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gymly-backup backup
TimeoutStartSec=2h
SuccessExitStatus=75
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
